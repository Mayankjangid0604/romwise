# -------------------------------------------------------------
# ROAMWISE STAGING ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------
# Ensure all placeholders are replaced with actual staging credentials.
# Do NOT commit the actual `.env.staging` file with secrets to git.
# -------------------------------------------------------------

# --- REQUIRED: CORE ---
# The canonical origin URL of the staging server (e.g. https://staging.roamwise.com)
APP_URL=
# The same as APP_URL if required by client code (e.g., share links if SSR fails)
NEXT_PUBLIC_APP_URL=
# 32-byte secure random string for NextAuth encryption
AUTH_SECRET=
# The staging PostgreSQL connection string
DATABASE_URL=

# --- REQUIRED: AI ---
# Gemini API Key for Trip Brain features
GEMINI_API_KEY=

# --- OPTIONAL: SMS / AUTH ---
# If TWILIO variables are empty/missing, SMS auth will log a warning and FAIL in production/staging.
# Either provide these or disable phone auth for the staging build.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- OPTIONAL: JOBS ---
# Secret for internal cron job triggers
INTERNAL_JOB_SECRET=

# --- E2E / MOCK FLAGS (MUST BE FALSE OR UNSET IN STAGING) ---
# E2E_TEST_MODE=false
# E2E_AI_MOCK=false
# OTP_TEST_BYPASS=false
