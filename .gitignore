# four byte-identical copies, so they are artifacts rather than source
.agents/
.cursor/
.devin/
.claude/skills/
.neon

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
test-results/
playwright-report/

# Data import files
data-import/raw/
data-import/processed/
*.osm.pbf
*.osm
cities500.txt
alternateNames.txt
IN.txt

