generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Authentication ────────────────────────────────────────────────────────────

model User {
  id              String        @id @default(cuid())
  email           String?       @unique
  phone           String?       @unique
  name            String
  passwordHash    String?
  phoneVerified   Boolean       @default(false)
  tripGenerations Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  trips           Trip[]
  groupMembers    GroupMember[]
  otpCodes        OtpCode[]
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, verified])
}

// ── Geographic reference (administrative districts) ────────────────────────────
// Source: India district registry built from Wikipedia + Census 2011 + OSM
// These are NOT tourist destinations — they are administrative divisions.
// Coordinates are approximate area centroids, not navigation points.

model District {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  state        String
  lat          Float
  lng          Float
  population   Int?
  dataSource   String?
  createdAt    DateTime            @default(now())
  destinations TravelDestination[]

  @@index([state])
}

// ── Travel destinations ────────────────────────────────────────────────────────
// A tourist destination — may or may not correspond to an administrative district.
// Examples: Jaipur, Rishikesh, Goa, Manali, Havelock Island

model TravelDestination {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  state       String
  country     String             @default("India")
  lat         Float
  lng         Float
  description String?
  // Optional link to the administrative district this destination sits within
  districtId  String?
  district    District?          @relation(fields: [districtId], references: [id], onDelete: SetNull)
  aliases     DestinationAlias[]
  places      Place[]
  trips       Trip[]
  // seed | verified | needs_review | deprecated
  dataStatus  String             @default("seed")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([state])
}

// Alternate names that resolve to a canonical TravelDestination
model DestinationAlias {
  id            String            @id @default(cuid())
  alias         String            @unique
  destinationId String
  destination   TravelDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
}

// ── Places / Points of Interest ───────────────────────────────────────────────
// Real places within a travel destination.
// These are the unit of truth for itinerary generation.

model Place {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  destinationId    String
  destination      TravelDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  area             String?
  description      String?
  // Must be one of PLACE_CATEGORIES in src/lib/categories.ts
  category         String
  lat              Float
  lng              Float
  typicalCostInr   Int?
  durationMinutes  Int?
  // "HH:MM" format, null if unknown
  openingTime      String?
  closingTime      String?
  // e.g. "Oct-Mar" or "year-round"
  bestSeason       String?
  vibes            String?
  // 1–5 (1 = not accessible, 5 = fully accessible), null if unknown
  accessibilityScore Int?
  // 0–100
  popularityScore  Int               @default(50)
  hiddenGem        Boolean           @default(false)
  // seed | verified | needs_review | deprecated
  dataStatus       String            @default("seed")
  // curated | ai_enriched | imported | official | fixture
  sourceType       String            @default("curated")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  itineraryItems   ItineraryItem[]

  @@index([destinationId])
  @@index([category])
}

// ── Trips ─────────────────────────────────────────────────────────────────────

model Trip {
  id             String             @id @default(cuid())
  title          String
  destination    String
  startDate      DateTime
  endDate        DateTime
  budgetInr      Int
  maxTravelers   Int                @default(20)
  paceLevel      String             @default("balanced")
  // draft | planning | stale
  status         String             @default("draft")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  creatorId      String
  creator        User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  destinationId  String?
  destinationRef TravelDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  groupMembers   GroupMember[]
  itineraryDays  ItineraryDay[]
  packingItems   PackingItem[]
  staySelection  StaySelection?
}

model GroupMember {
  id                  String               @id @default(cuid())
  role                String               @default("member")
  preferences         String               @default("[]")
  accessibilityNotes  String               @default("")
  joinedAt            DateTime             @default(now())
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId              String
  trip                Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  travelerPreferences TravelerPreference[]

  @@unique([userId, tripId])
}

model TravelerPreference {
  id            String      @id @default(cuid())
  category      String
  priority      String
  groupMemberId String
  groupMember   GroupMember @relation(fields: [groupMemberId], references: [id], onDelete: Cascade)

  @@unique([groupMemberId, category])
}

model PackingItem {
  id        String  @id @default(cuid())
  label     String
  category  String
  checked   Boolean @default(false)
  essential Boolean @default(false)
  tripId    String
  trip      Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model StaySelection {
  id              String @id @default(cuid())
  hotelName       String
  costPerNightInr Int
  totalCostInr    Int
  nights          Int
  lat             Float
  lng             Float
  tripId          String @unique
  trip            Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model ItineraryDay {
  id        String          @id @default(cuid())
  dayNumber Int
  date      DateTime
  tripId    String
  trip      Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items     ItineraryItem[]

  @@unique([tripId, dayNumber])
}

model ItineraryItem {
  id               String       @id @default(cuid())
  title            String
  description      String
  category         String
  startTime        String
  endTime          String
  estimatedCostInr Int          @default(0)
  reasoning        String
  order            Int
  itineraryDayId   String
  itineraryDay     ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  // Optional link to a known Place — null means item is not grounded to a known POI
  placeId          String?
  place            Place?       @relation(fields: [placeId], references: [id], onDelete: SetNull)
}
