# -------------------------------------------------------------
# ROAMWISE ENVIRONMENT CONFIGURATION (EXAMPLE)
# -------------------------------------------------------------

# --- REQUIRED: CORE ---
# The canonical origin URL of the server (e.g. http://localhost:3000 in dev)
APP_URL="http://localhost:3000"
# Client-side base URL (optional, defaults to relative if empty)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# 32-byte secure random string for NextAuth encryption
AUTH_SECRET="your-super-secret-key-at-least-32-chars-long"
# The PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/roamwise"

# --- REQUIRED: AI ---
# Gemini API Key for Trip Brain features
GEMINI_API_KEY="your-gemini-api-key"

# --- OPTIONAL: SMS / AUTH ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# --- OPTIONAL: JOBS ---
INTERNAL_JOB_SECRET="some-secret-string-for-cron"

# --- TEST-ONLY / DEVELOPMENT FLAGS ---
# MUST BE FALSE IN PRODUCTION
E2E_TEST_MODE="false"
E2E_AI_MOCK="false"
OTP_TEST_BYPASS="false"
