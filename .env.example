# Database — PostgreSQL connection string (required)
# For local dev: run Postgres locally or use a free Neon/Supabase instance
# For production: use the connection string from your provider
DATABASE_URL="postgresql://user:password@localhost:5432/roamwise"

# NextAuth secret — used to sign/encrypt JWT tokens (required)
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google Gemini API key — needed for AI discovery and group alignment features
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
